            },
            "scale": {
                "x": 1.0,
                "y": 1.0,
                "z": 1.0
            },
            "fontSize": 36.0,
            "fields": [
                "FAQDesc.fAQPanel = ",
                "FAQDesc.tMP_Text = Content (1)/Scroll View/Viewport/Content/q2"
            ]
        },
        {
            "path": "Content (1)/Scroll View/Viewport/Content/q3",
            "type": " RectTransform CanvasRenderer TextMeshProUGUI ContentSizeFitter FAQDesc",
            "sprite": "",
            "text": "<color=#174F7D><b>Why did my withdrawal fail?</b></color>\r\n<color=#174F7D>\rIf a withdrawal fails, the system will provide the reason in English. Please modify your information according to the prompt. If the withdrawal fails, the withdrawal amount will be returned automatically. You can update your information and initiate the withdrawal again. Please make sure all the information you provide is correct. We are <color=#A84A3A><b>not responsible</b></color> for withdrawal failures caused by incorrect information.\r</color>",
            "active": true,
            "position": {
                "x": 374.6852111816406,
                "y": -1334.580078125
            },
            "size": {
                "x": 749.3704223632813,
