        {
            "path": "Content (1)/Scroll View/Viewport/Content/q1",
            "type": " RectTransform CanvasRenderer TextMeshProUGUI ContentSizeFitter FAQDesc",
            "sprite": "",
            "text": "<color=#174F7D>我怎样才能提取现金呢?</color>\r\n<color=#9E5A41>每通过一个关卡都有现金奖励。通过的关卡越多，获得的奖励就越多。达到提现要求后，您可以提现。.</color>",
            "active": true,
            "position": {
                "x": 374.6852111816406,
                "y": -222.83999633789063
            },
            "size": {
                "x": 749.3704223632813,
                "y": 0.0
            },
            "min": {
                "x": 0.0,
                "y": 1.0
            },
            "max": {
                "x": 0.0,
                "y": 1.0
            },
            "pivot": {
                "x": 0.5,
                "y": 0.0
            },
            "scale": {
                "x": 1.0,
                "y": 1.0,
                "z": 1.0
            },
            "fontSize": 36.0,
            "fields": [
                "FAQDesc.fAQPanel = ",
                "FAQDesc.tMP_Text = Content (1)/Scroll View/Viewport/Content/q1"
            ]
        },
        {
            "path": "Content (1)/Scroll View/Viewport/Content/q2",
            "type": " RectTransform CanvasRenderer TextMeshProUGUI ContentSizeFitter FAQDesc",
            "sprite": "",
            "text": "<color=#174F7D><b>How long does it take to withdraw money?</b></color>\r\n<color=#174F7D>\rGenerally, funds will be credited to your account within a few minutes. If the number of withdrawals or the withdrawal amount exceeds a certain limit, the system will review it. In this case, the funds will still be credited within <color=#C9785D><b>24 hours</b></color>, so please don’t worry.\r</color>\r",
            "active": true,
            "position": {
                "x": 374.6852111816406,
                "y": -701.489990234375
            },
            "size": {
                "x": 749.3704223632813,
                "y": 0.0
            },
            "min": {
                "x": 0.0,
                "y": 1.0
            },
            "max": {
                "x": 0.0,
                "y": 1.0
            },
            "pivot": {
                "x": 0.5,
