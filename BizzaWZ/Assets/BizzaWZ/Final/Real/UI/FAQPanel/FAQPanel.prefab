  m_text: "<color=#5E200C><b>Why did my withdrawal fail?</b></color>\r\n<color=#5E200C>\rIf
    a withdrawal fails, the system will provide the reason in English. Please modify
    your information according to the prompt. If the withdrawal fails, the withdrawal
    amount will be returned automatically. You can update your information and initiate
    the withdrawal again. Please make sure all the information you provide is correct.
    We are <color=#A84A3A><b>not responsible</b></color> for withdrawal failures
    caused by incorrect information.\r</color>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: ec15d58abbe0f034cb79e66eea89921a, type: 2}
